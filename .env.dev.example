# Development / test environment — copy to .env.dev and fill in.
#
#   cp .env.dev.example .env.dev
#   docker compose -f compose.dev.yml --env-file .env.dev up --build
#
# IMPORTANT: use a SEPARATE Discord application/bot token here (not the production
# one). Discord allows only one gateway connection per token, so reusing the prod
# token would make the two bots disconnect each other. Create a second bot at
# https://discord.com/developers/applications and invite it to your TEST server.

# Token of the dedicated TEST bot
DISCORD_TOKEN=your_test_bot_token_here

# Password for the isolated dev Postgres (any value; separate from prod)
POSTGRES_PASSWORD=devpass

# Your TEST server (guild) ID
GUILD_ID=your_test_guild_id_here

# A channel ID in the TEST server for audit logs
LOG_CHANNEL_ID=your_test_log_channel_id_here

# Optional — comma-separated channel IDs dropped from the audit log entirely (channel + DB)
LOG_IGNORED_CHANNEL_IDS=

# Optional — comma-separated event types kept OUT of the log channel (still saved to the DB).
# Empty/unset = mirror every event (the default). If the channel ever gets too loud, the
# usual suspects are: message_sent,slash_command,voice_muted,voice_unmuted,voice_deafened,voice_undeafened
LOG_MUTED_EVENTS=

# Optional: betting. Set at least one key, then run /setup betting <channel> in Discord.
# (The currency leaderboard and betting channels are chosen via /setup, not env vars.)
# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# Free tier: https://pandascore.co/
PANDASCORE_API_KEY=

# --- Music (Lavalink) --- defaults work out of the box
LAVALINK_PASSWORD=youshallnotpass
# Shared between the lavalink and ytcipher services (YouTube signature deciphering).
YTCIPHER_TOKEN=youshallnotpass

# Optional: Spotify support
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
