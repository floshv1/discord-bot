DISCORD_TOKEN=your_bot_token_here
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://botuser:change_me@localhost:5432/discord_bot
GUILD_ID=your_guild_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
# Optional: comma-separated channel IDs dropped from the audit log entirely (channel + DB)
LOG_IGNORED_CHANNEL_IDS=
# Optional: comma-separated event types kept OUT of the log channel (still saved to the DB).
# Empty/unset = mirror every event (the default). If the channel ever gets too loud, the
# usual suspects are: message_sent,slash_command,voice_muted,voice_unmuted,voice_deafened,voice_undeafened
LOG_MUTED_EVENTS=

# --- Betting providers (optional; each provider is skipped if its key is unset) ---
FOOTBALL_DATA_API_KEY=
PANDASCORE_API_KEY=

# --- Music (Lavalink) ---
# Default values work with docker-compose. Only set these to override.
LAVALINK_PASSWORD=youshallnotpass

# Optional: Spotify support (create app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Dashboard (api + web services) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=change_me_to_a_random_secret

# Create an OAuth2 app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_oauth2_client_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret

# Must match exactly what you set in the Discord OAuth2 redirect URIs
# Points to Next.js (port 3100) which proxies to FastAPI — cookie is set on the right origin
# Production: https://floshhomeserver.drum-discus.ts.net:3100/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3100/auth/callback

# Where the API redirects after successful OAuth login (your web frontend URL)
# Production: https://floshhomeserver.drum-discus.ts.net:3100/overview
FRONTEND_URL=http://localhost:3100/overview

# Comma-separated allowed origins for CORS (the web frontend URL)
# Production: https://floshhomeserver.drum-discus.ts.net:3100
CORS_ORIGINS=http://localhost:3100

# URL the Next.js frontend uses to reach the FastAPI backend
# NOTE: This is baked into the Next.js image at build time via Docker build-arg.
# Set it as a GitHub Actions secret (NEXT_PUBLIC_API_URL) so CI uses the right value.
# Production: https://floshhomeserver.drum-discus.ts.net:8090
NEXT_PUBLIC_API_URL=http://localhost:8090
